# Copy to .env.local (not committed) and restart `npm run customer` after changes: Expo inlines these at build time.
# Everything here is public (it ships inside the app). Never put secrets in EXPO_PUBLIC_* variables.

# The API root, absolute. On a phone, "localhost" is the phone itself: use your computer's LAN address
# (e.g. http://192.168.1.10:3000/api/v1) with the backend listening on 0.0.0.0, or an HTTPS tunnel.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/api/v1

# How chat screens learn about new messages: "socket" (default) or "poll".
EXPO_PUBLIC_CHAT_TRANSPORT=socket

# Who serves the share pages (/share/venues/<slug>); the API's origin when unset.
# EXPO_PUBLIC_SHARE_BASE_URL=https://wedwizz.example

# The WedWizz website (e.g. https://wedwizz.example). The welcome screen's "Are you a vendor? Log in here" opens
# <this>/login there; the link is hidden when unset.
# EXPO_PUBLIC_WEB_BASE_URL=https://wedwizz.example
